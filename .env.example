# Leave these unset to run CampusTutor entirely on its built-in mock backend
# (seeded sample data, persisted to localStorage) — no Supabase project required.
#
# To connect a real Supabase project: run the SQL in supabase/migrations against it,
# then set both of these and restart the dev server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PayMongo (server-side only — never expose the secret key to the frontend).
# Used by a Supabase Edge Function in production; the frontend always talks to
# your own backend/edge function, never to PayMongo directly.
# PAYMONGO_SECRET_KEY=
